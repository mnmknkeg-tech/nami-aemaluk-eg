# Application
APP_ENV=development
APP_NAME=ray-backend-go
APP_VERSION=0.1.0
PORT=4000
HOST=0.0.0.0
FRONTEND_APP_URL=http://localhost:5174

# Database (PostgreSQL)
# Local dev: docker compose up -d postgres redis
DATABASE_URL=postgresql://ray_user:ray_password@localhost:5433/ray_marketplace?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m
# Apply pending migrations on startup, then verify the schema is complete.
DB_MIGRATE_ON_BOOT=true
# auto | simple | cache_statement | cache_describe | describe | exec
# "auto" is the default: the URL is inspected and prepared statements are
# disabled automatically when a transaction-mode pooler is detected.
DB_QUERY_EXEC_MODE=auto

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth & Security
# Generate: openssl rand -hex 32  (or: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=2b9d4a7f1c8e5b3a6d9f0e4c7b2a5d8f1e3c9a7b4d6f8e2c5a1b7d3f9e6c8b
ADMIN_BOOTSTRAP_TOKEN=8fX2bZ7mNv9qW1sV3yL5kR6jP0gH4dA8eC9iB7cD6fE0gK1jLmN3xQ4zT5uW6v
ALLOW_DEV_ADMIN_BOOT=false
ALLOW_DEV_MERCHANT_BOOT=false
ALLOW_DEV_COURIER_BOOT=false
CSRF_DISABLED=false
AUTH_ACCESS_COOKIE_NAME=ray_access
AUTH_REFRESH_COOKIE_NAME=ray_session
CORS_ORIGIN=https://nami-aemaluk-eg-dashboard-web.vercel.app,https://nami-aemaluk-eg-marketplace.vercel.app,https://nami-aemaluk-eg-business.vercel.app
# Token lifetimes: 15m access, 7d sliding refresh session, 30d absolute cap.
AUTH_ACCESS_TOKEN_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=168h
AUTH_COOKIE_MAX_AGE=168h
AUTH_SESSION_ABSOLUTE_TTL=720h
AUTH_REFRESH_GRACE=60s
AUTH_ACCESS_COOKIE_NAME=ray_access
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_REFRESH_RATE_LIMIT_WINDOW=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=console

# Media / External
# Local development option: start MinIO with `docker compose up -d minio`
# and use the values below. Production should use Cloudflare R2 or AWS S3.
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=ray_minio
S3_SECRET_ACCESS_KEY=ray_minio_dev_password
S3_BUCKET=ray-media
S3_PUBLIC_BASE_URL=http://localhost:9000/ray-media

# Search
ELASTICSEARCH_URL=http://localhost:9200

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
