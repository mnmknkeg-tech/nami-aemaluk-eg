NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# --- Cross-app: merchant acquisition app (business) ---
# Used by the "create a merchant account" link on the login page. Unset in
# production falls back to the live business deployment.
NEXT_PUBLIC_BUSINESS_URL=https://business-blond-psi.vercel.app

# Independent merchant storefront. Leave blank for built-in production/local defaults.
NEXT_PUBLIC_MERCHANT_STOREFRONT_URL=
# Optional verified custom-domain template, e.g. https://{slug}.mnmknk.com
NEXT_PUBLIC_MERCHANT_SITE_URL_TEMPLATE=
# Emergency rollback only; normally keep false.
NEXT_PUBLIC_MERCHANT_ALLOW_LEGACY_SITE_URL=false
