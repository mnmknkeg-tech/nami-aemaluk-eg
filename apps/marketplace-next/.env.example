# New Next marketplace frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Comma-separated allowlist for next/image remote sources.
# Add your CDN/media host here instead of allowing every hostname.
NEXT_PUBLIC_IMAGE_HOSTS=mnmknk.com,api.mnmknk.com,localhost

NEXT_PUBLIC_DASHBOARD_URL=https://localhost:3010

# Merchant storefront external URL template — used by /dalil and /map to link
# to a merchant's standalone site in a new tab (decoupled from the marketplace
# SPA). `{slug}` is replaced with the shop slug at render time. Two patterns:
#
#   1. Wildcard subdomain (true domain separation, requires wildcard DNS):
#        NEXT_PUBLIC_MERCHANT_BASE_URL=https://{slug}.mnmknk.com
#
#   2. Path on the marketplace domain (still opens in a new tab so the back
#      button doesn't tangle; AppChrome strips marketplace chrome for
#      /site/* paths so the merchant site renders standalone):
#        NEXT_PUBLIC_MERCHANT_BASE_URL=https://mnmknk.com/site/{slug}
#
# If unset: the helper auto-detects — production on mnmknk.com / ray.eg
# uses the wildcard subdomain, everything else falls back to the path form.
NEXT_PUBLIC_MERCHANT_BASE_URL=
